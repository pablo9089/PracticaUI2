<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticaUI2.LoginPage"
             Title="Iniciar sesión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7FB">
    <ContentPage.Resources>
        <LinearGradientBrush x:Key="LoginBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF1FF" Offset="0" />
            <GradientStop Color="#F8FAFF" Offset="0.55" />
            <GradientStop Color="#E8E2FF" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="24,40" Background="{StaticResource LoginBackground}">
            <Border
                MaximumWidthRequest="500"
                Padding="28,32"
                BackgroundColor="White"
                StrokeThickness="0"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,8" Radius="22" Opacity="0.45" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <Border
                        WidthRequest="72"
                        HeightRequest="72"
                        BackgroundColor="#EEF0FF"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Label
                            Text="✦"
                            TextColor="#5B55D6"
                            FontSize="38"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Text="Bienvenido de nuevo"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#20233A"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Inicia sesión para continuar"
                        FontSize="15"
                        TextColor="#777B91"
                        HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                        <Label Text="Correo electrónico" FontAttributes="Bold" TextColor="#34374D" FontSize="14" />
                        <Border Stroke="#E1E4EF" StrokeThickness="1" BackgroundColor="#FAFBFF" Padding="14,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry
                                x:Name="EmailEntry"
                                Placeholder="tu@correo.com"
                                Keyboard="Email"
                                TextColor="#25283D"
                                PlaceholderColor="#A7ABBC"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" FontAttributes="Bold" TextColor="#34374D" FontSize="14" />
                        <Border Stroke="#E1E4EF" StrokeThickness="1" BackgroundColor="#FAFBFF" Padding="14,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Introduce tu contraseña"
                                IsPassword="True"
                                TextColor="#25283D"
                                PlaceholderColor="#A7ABBC"
                                BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        Text="¿Has olvidado tu contraseña?"
                        TextColor="#5B55D6"
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="End" />

                    <Button
                        Text="Iniciar sesión"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#5B55D6"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="54"
                        Margin="0,6,0,0" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="¿No tienes una cuenta?" TextColor="#777B91" FontSize="14" />
                        <Label Text="Regístrate" TextColor="#5B55D6" FontAttributes="Bold" FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>